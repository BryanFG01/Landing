---
import { Image } from 'astro:assets';
import { assetFor } from '../domain/assets';
import type { Props } from './Logo.types';

// Logo redondo + nombre en texto (el logo es una ilustración: en pequeño, el nombre al lado es lo que se lee).
// El tamaño se da con clases de texto (text-lg, text-2xl…): la imagen mide 2em y escala con él.

const { site, class: className = 'text-xl' } = Astro.props;
const asset = assetFor(site.marca.logo.src);
const imgClass = 'size-[2em] shrink-0 rounded-full bg-white object-cover ring-1 ring-crema/20';
---

<span class:list={['inline-flex items-center gap-[0.5em] leading-none whitespace-nowrap', className]}>
  {
    asset ? (
      <Image
        src={asset}
        alt=""
        aria-hidden="true"
        width={96}
        height={96}
        densities={[1, 2]}
        format="webp"
        loading="eager"
        decoding="async"
        class={imgClass}
      />
    ) : (
      site.marca.logo.src && <img src={site.marca.logo.src} alt="" aria-hidden="true" width="96" height="96" class={imgClass} />
    )
  }
  <span class="font-display">{site.marca.nombre}</span>
</span>
