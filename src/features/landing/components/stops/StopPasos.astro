---
// Estilo "Pasos numerados": el valor es el paso y la etiqueta, su explicación (opcional).
import type { ItemsProps as Props } from './types';

const { items } = Astro.props;
---

<ol class="mt-6 flex max-w-md flex-col gap-4">
  {
    items.map((it, n) => (
      <li class="flex gap-4">
        <span class="font-display text-2xl text-teja">{n + 1}</span>
        <div>
          <h3 class="text-lg">{it.valor}</h3>
          {it.etiqueta && <p class="text-sm text-crema/70">{it.etiqueta}</p>}
        </div>
      </li>
    ))
  }
</ol>
