---
import Icon from './Icon.astro';
import { links, rich, type BloquePreguntas, type SiteContent } from '../data/sitio';

interface Props {
  bloque: BloquePreguntas;
  site: SiteContent;
}

const { bloque, site } = Astro.props;
const { pedir, telefono } = links(site);
---

<section id="preguntas" data-spy="#preguntas" aria-labelledby="faq-title" class="px-4 py-24 md:px-12 xl:px-24">
  <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <p data-reveal class="text-sm text-teja">{bloque.eyebrow}</p>
      <h2 id="faq-title" data-reveal style="--d:100ms" class="mt-4 text-3xl lg:text-5xl">{bloque.titulo}</h2>
      {bloque.texto && <p data-reveal style="--d:200ms" class="mt-6 max-w-sm text-base text-crema/70">{bloque.texto}</p>}
      <p data-reveal style="--d:250ms" class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        <a href={pedir} class="link" rel="noopener" target="_blank">Escríbenos por WhatsApp</a>
        <a href={telefono} class="link whitespace-nowrap">{site.contacto.telefono}</a>
      </p>
    </div>

    <div class="divide-y divide-crema/10">
      {
        bloque.items.map((faq) => (
          <details data-reveal class="faq group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-xl py-6 text-left text-lg transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:text-teja">
              <h3 class="font-sans text-lg">{faq.pregunta}</h3>
              <Icon name="plus" class="faq-icon size-6 shrink-0 text-teja" />
            </summary>
            <div class="pb-6">
              <p class="max-w-2xl text-base text-crema/70" set:html={rich(faq.respuesta)} />
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
