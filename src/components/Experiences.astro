---
import { Picture } from 'astro:assets';
import Pending from './Pending.astro';
import { aLaMedida, combos, links, photos } from '../data/finca';
---

<section id="combos" data-spy="#combos" aria-labelledby="combos-title" class="px-4 py-24 md:px-12 xl:px-24">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-xl">
      <p data-reveal class="text-sm text-teja">Combos para la casa</p>
      <h2 id="combos-title" data-reveal style="--d:100ms" class="mt-4 text-3xl lg:text-5xl">Huevos y pollo, en un solo pedido</h2>
      <p data-reveal style="--d:200ms" class="mt-6 text-base text-crema/70 lg:text-lg">
        Elige un combo para la semana o arma tu pedido con las cantidades que necesites.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-[1fr_1fr_0.9fr]">
      {
        combos.map((combo, i) => (
          <article
            data-reveal
            style={`--d:${i * 100}ms`}
            class:list={[
              'relative flex flex-col rounded-3xl p-6 ring-1 lg:p-8',
              combo.etiqueta ? 'ring-teja/60' : 'ring-crema/15',
            ]}
          >
            {combo.etiqueta && (
              <p class="absolute -top-3 left-6 rounded-full bg-teja px-3 py-1 text-xs font-medium text-bg lg:left-8">
                {combo.etiqueta}
              </p>
            )}
            <h3 class="text-2xl">{combo.nombre}</h3>
            <p class="mt-2 text-base text-crema/70">{combo.descripcion}</p>
            <p class="mt-8 font-display text-5xl">{combo.precio}</p>
            <p class="mt-1 text-sm text-crema/50">{combo.nota}</p>
            <div class="mt-8 flex flex-1 items-end">
              <a href={links.pedir} class="btn btn-primary" rel="noopener" target="_blank"><span>Pedir este combo</span></a>
            </div>
          </article>
        ))
      }

      <article data-reveal style="--d:200ms" class="flex flex-col items-center gap-6 rounded-3xl p-6 text-center ring-1 ring-crema/15 lg:p-8">
        <div class="mirror-frame mask-oval w-40 lg:w-48">
          <Picture
            src={photos.recogida}
            alt="Canasta de mimbre con huevos colorados sobre un paño"
            formats={['avif', 'webp']}
            widths={[320, 480]}
            sizes="192px"
            loading="lazy"
            decoding="async"
            pictureAttributes={{ class: 'block' }}
            class="aspect-[3/4] w-full mask-oval object-cover"
          />
        </div>
        <div>
          <h3 class="text-2xl">{aLaMedida.nombre}</h3>
          <p class="mt-2 text-base text-crema/70">{aLaMedida.descripcion}</p>
        </div>
        <p class="font-display text-4xl">{aLaMedida.precio}</p>
      </article>
    </div>

    <Pending class="mt-8 max-w-xl">Confirmar combos, qué incluye cada uno y su precio.</Pending>
  </div>
</section>
