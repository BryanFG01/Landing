---
import { Picture } from 'astro:assets';
import Pending from './Pending.astro';
import Stop from './Stop.astro';
import { contacto, links, marca, paseo, precioPanal, precioPollo } from '../data/finca';

const { paradas } = paseo;
const body = 'mt-4 max-w-md text-base text-crema/80 lg:text-lg';
const title = 'mt-4 max-w-xl text-4xl lg:text-5xl xl:text-6xl';
const pill = 'rounded-full bg-bg/40 px-3 py-1 ring-1 ring-crema/20 backdrop-blur-md';
---

<section id="recorrido" data-world aria-label="Paseo por la finca" class="relative">
  <!-- Escenario fijo. Los vídeos son verticales (grabados con el celular): en móvil ocupan toda la pantalla; en
       escritorio, la mitad derecha de borde a borde (pantalla dividida, el texto a la izquierda). Debajo de cada clip, su
       primer fotograma con el mismo encuadre, para que el vídeo entre sin que se note el cambio. -->
  <div data-stage class="sticky top-0 h-lvh overflow-hidden bg-bg" style="--focus-x: 50%">
    <div aria-hidden="true" class="media absolute inset-0">
      {
        paradas.map((parada, i) => (
          <div data-frame class="frame absolute inset-0" style={i === 0 ? undefined : 'opacity: 0'}>
            <Picture
              src={parada.poster}
              alt=""
              formats={['avif', 'webp']}
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'low'}
              decoding="async"
              pictureAttributes={{ class: 'block size-full' }}
              class="size-full object-cover"
              style="object-position: var(--focus-x) 50%"
            />
          </div>
        ))
      }
      <div class="clips absolute inset-0">
        {
          paradas.map((parada) => (
            <video
              data-clip
              data-src={parada.clip ?? ''}
              data-auto={parada.reproduccion === 'auto' ? '' : undefined}
              data-continua={parada.continua ? '' : undefined}
              loop={parada.reproduccion === 'auto'}
              muted
              playsinline
              preload="none"
              disablepictureinpicture
              disableremoteplayback
              tabindex="-1"
              class="clip absolute inset-0 size-full object-cover"
            />
          ))
        }
      </div>
    </div>

    <!-- Velos para leer el texto encima del vídeo. -->
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-40 bg-linear-to-b from-bg/60 to-transparent"></div>
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-linear-to-t from-bg from-15% via-bg/50 via-50% to-transparent to-80% max-lg:from-30% max-lg:via-bg/70 max-lg:via-55% lg:bg-linear-to-r lg:from-bg/85 lg:via-bg/35 lg:via-35% lg:to-transparent lg:to-65%"
    >
    </div>
    <div aria-hidden="true" class="absolute inset-x-0 bottom-0 hidden h-1/2 bg-linear-to-t from-bg/80 to-transparent lg:block"></div>

    <!-- Raíl de paradas. -->
    <nav aria-label="Paradas del paseo" class="absolute top-1/2 right-6 hidden -translate-y-1/2 lg:block xl:right-8">
      <ol class="relative flex flex-col items-end gap-4">
        <span aria-hidden="true" class="absolute top-3 right-1 bottom-3 w-px translate-x-1/2 bg-crema/20">
          <span data-rail-fill class="absolute inset-0 origin-top scale-y-0 bg-teja"></span>
        </span>
        {
          paradas.map((parada, i) => (
            <li>
              <a href={`#${parada.id}`} data-goto aria-current={i === 0 ? 'true' : 'false'} class="rail-link group flex h-6 items-center gap-3">
                <span class="rail-label rounded-full bg-bg/60 px-3 py-1 text-xs whitespace-nowrap text-crema ring-1 ring-crema/10 backdrop-blur-xl">
                  {parada.lugar}
                </span>
                <span class="relative grid size-2 place-items-center">
                  <span class="rail-dot size-2 rounded-full bg-crema/50" />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <p
      data-hint
      aria-hidden="true"
      class="absolute right-8 bottom-8 hidden items-center gap-3 text-xs tracking-widest text-crema/70 uppercase lg:flex"
    >
      Desliza para recorrer la finca
      <span class="hint-line relative block h-8 w-px overflow-hidden bg-crema/20"></span>
    </p>
  </div>

  <!-- Paradas: cada una deja su texto abajo a la izquierda mientras el paseo avanza. -->
  <div class="relative z-10 -mt-[100lvh]">
    <Stop index={0} spy="#inicio">
      <!-- La marca y el producto van dentro del h1 para que el titular principal diga qué es y qué vende. -->
      <h1 class="mt-4">
        <span class="block font-sans text-xs font-medium tracking-widest text-teja uppercase">
          {marca.nombre} · {marca.lema}
        </span>
        <span
          class="hero-title mt-4 block max-w-[680px] bg-linear-to-r from-crema to-[#c5d3a6] bg-clip-text pb-2 text-4xl text-transparent lg:text-6xl"
        >
          Del campo a tu mesa
        </span>
      </h1>
      <p class={body}>
        Pollo campesino de piel amarilla natural, criado sin químicos ni aceleradores, y huevos colorados de gallinas al
        aire libre. Pides por WhatsApp y te lo llevamos el mismo día.
      </p>
      <a href={links.pedir} class="btn btn-primary mt-6" rel="noopener" target="_blank"><span>Pedir por WhatsApp</span></a>
      <ul class="mt-6 flex flex-wrap gap-2 text-xs text-crema/80" aria-label="Lo que ofrecemos">
        <li class={pill}>Pollo a {precioPollo} la libra, domicilio incluido</li>
        <li class={pill}>Panal de huevos a {precioPanal}</li>
        <li class={pill}>Entrega el mismo día</li>
      </ul>
    </Stop>

    <Stop index={1} eyebrow="Cómo criamos">
      <h2 class={title}>Gallinas bien comidas, huevos con sabor</h2>
      <p class={body}>
        Nuestras gallinas comen grano y verdura fresca todos los días, con espacio para moverse a su ritmo.
      </p>
      <p class="mt-4 max-w-md text-sm text-crema/60">
        Una gallina tranquila y bien alimentada pone mejor huevo. Por eso cuidamos el espacio, el agua limpia y la comida
        de cada día.
      </p>
      <Pending class="mt-4 max-w-md">Confirmar cómo se crían las gallinas y con qué se alimentan.</Pending>
    </Stop>

    <Stop index={2} eyebrow="Precios claros">
      <h2 class={title}>Sabes lo que pagas antes de pedir</h2>
      <p class={body}>
        Todo se pesa. El pollo se pesa completo y cada libra vale {precioPollo}, entero o despresado, con el domicilio
        incluido. Te confirmamos el total por WhatsApp antes de despachar.
      </p>
      <dl class="mt-6 grid w-full max-w-md grid-cols-2 gap-4">
        <div class="flex flex-col-reverse gap-1">
          <dt class="text-xs text-crema/60">Libra de pollo, con domicilio incluido</dt>
          <dd class="font-display text-3xl lg:text-4xl">{precioPollo}</dd>
        </div>
        <div class="flex flex-col-reverse gap-1">
          <dt class="text-xs text-crema/60">Panal de 30 huevos colorados</dt>
          <dd class="font-display text-3xl lg:text-4xl">{precioPanal}</dd>
        </div>
      </dl>
      <a href="#productos" class="link mt-6 text-sm">Ver todos los productos</a>
    </Stop>

    <Stop index={3} eyebrow="Frescura">
      <h2 class={title}>Huevos de días, no de semanas</h2>
      <p class={body}>
        Recogemos los huevos cada día, los revisamos uno a uno y los empacamos en cubetas para que lleguen enteros a tu
        casa.
      </p>
      <ul class="mt-6 grid w-full max-w-md grid-cols-2 gap-4">
        <li class="flex flex-col gap-1 rounded-2xl bg-bg/40 p-4 ring-1 ring-crema/15 backdrop-blur-md">
          <span class="font-display text-2xl lg:text-3xl">A diario</span>
          <span class="text-xs text-crema/70 lg:text-sm">Recogida de huevos en la finca</span>
        </li>
        <li class="flex flex-col gap-1 rounded-2xl bg-bg/40 p-4 ring-1 ring-crema/15 backdrop-blur-md">
          <span class="font-display text-2xl lg:text-3xl">Uno a uno</span>
          <span class="text-xs text-crema/70 lg:text-sm">Revisados antes de empacar</span>
        </li>
      </ul>
      <Pending class="mt-4 max-w-md">Confirmar cada cuánto se recoge y cuántos días pasan hasta la entrega.</Pending>
    </Stop>

    <Stop index={4} eyebrow="Pollo de campo">
      <h2 class={title}>Producción responsable, sabor auténtico del campo</h2>
      <p class={body}>
        Nuestros pollos crecen con espacio para caminar y luz natural. La carne queda firme y con el sabor del pollo de
        campo de toda la vida.
      </p>
      <div class="mt-6 flex items-end gap-4">
        <span class="font-display text-5xl text-teja lg:text-7xl">2</span>
        <span class="max-w-48 pb-1 text-sm text-crema/70">Formas de llevarlo: entero o despresado a mano</span>
      </div>
    </Stop>

    <Stop index={5} eyebrow="Cómo pedir">
      <h2 class={title}>Tu pedido, en tres pasos</h2>
      <ol class="mt-6 flex max-w-md flex-col gap-4">
        <li class="flex gap-4">
          <span class="font-display text-2xl text-teja">1</span>
          <div>
            <h3 class="text-lg">Escríbenos por WhatsApp</h3>
            <p class="text-sm text-crema/70">Dinos qué productos quieres y cuántos.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="font-display text-2xl text-teja">2</span>
          <div>
            <h3 class="text-lg">Confirmamos tu pedido</h3>
            <p class="text-sm text-crema/70">Te decimos el peso, el total y la hora de entrega.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="font-display text-2xl text-teja">3</span>
          <div>
            <h3 class="text-lg">Lo recibes en casa</h3>
            <p class="text-sm text-crema/70">
              Hoy mismo si confirmas antes de las 10:00&nbsp;a.&nbsp;m. Pagas al recibir: {contacto.pagosEnFrase}.
            </p>
          </div>
        </li>
      </ol>
      <Pending class="mt-4 max-w-md">Confirmar si el domicilio tiene costo en pedidos solo de huevos.</Pending>
      <a href={links.pedir} class="btn btn-primary mt-6" rel="noopener" target="_blank"><span>Pedir por WhatsApp</span></a>
    </Stop>
  </div>
</section>

<style>
  .frame {
    will-change: opacity, transform;
  }

  /* Escritorio: pantalla dividida. El vídeo vertical llena la mitad derecha a toda la altura (en media pantalla apenas
     se recorta y no pierde nitidez; a pantalla completa quedaría borroso, es de 576 px de ancho). Su borde izquierdo se
     funde con el fondo para que no haya una línea dura entre el texto y el vídeo. */
  @media (min-width: 1024px) {
    .media {
      left: auto;
      width: 48%;
      mask-image: linear-gradient(to right, transparent, #000 24%);
    }
  }

  @media (min-width: 1280px) {
    .media {
      width: 52%;
    }
  }

  .clips {
    opacity: 0;
    transition: opacity 1200ms var(--ease-fluid);
  }

  [data-mode='video'] .clips {
    opacity: 1;
  }

  /* Solo se ve el clip del tramo actual. Los clips son tomas distintas: al cambiar de tramo se funden en vez de cortar. */
  .clip {
    object-position: var(--focus-x) 50%;
    opacity: 0;
    transition: opacity 500ms var(--ease-fluid);
  }

  .clip.is-shown {
    opacity: 1;
  }

  .rail-label {
    opacity: 0;
    transform: translateX(0.5rem);
    transition:
      opacity 700ms var(--ease-fluid),
      transform 700ms var(--ease-fluid);
  }

  .rail-dot {
    transition:
      background-color 700ms var(--ease-fluid),
      transform 700ms var(--ease-fluid);
  }

  .rail-link:hover .rail-label,
  .rail-link:focus-visible .rail-label,
  .rail-link[aria-current='true'] .rail-label {
    opacity: 1;
    transform: none;
  }

  .rail-link:hover .rail-dot {
    background-color: var(--color-crema);
  }

  .rail-link[aria-current='true'] .rail-dot {
    background-color: var(--color-teja);
    transform: scale(1.5);
  }

  .hint-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-crema);
    animation: hint 2400ms var(--ease-fluid) infinite;
  }

  @keyframes hint {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hint-line::after {
      animation: none;
    }
  }
</style>
