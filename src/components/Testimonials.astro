---
import Icon from './Icon.astro';
import { links, type BloqueOpiniones, type SiteContent } from '../data/sitio';

interface Props {
  bloque: BloqueOpiniones;
  site: SiteContent;
}

const { bloque, site } = Astro.props;
---

<!-- Opiniones de clientes, junto al botón de pedir. -->
<section id="opiniones" data-spy="#opiniones" aria-labelledby="opiniones-title" class="px-4 py-24 md:px-12 xl:px-24">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <p data-reveal class="text-sm text-teja">{bloque.eyebrow}</p>
        <h2 id="opiniones-title" data-reveal style="--d:100ms" class="mt-4 text-3xl lg:text-5xl">{bloque.titulo}</h2>
      </div>
      <a
        data-reveal
        style="--d:200ms"
        href={links(site).pedir}
        class="link inline-flex items-center gap-2 self-start text-sm md:self-auto"
        rel="noopener"
        target="_blank"
      >
        Pedir por WhatsApp
        <Icon name="arrowUpRight" />
      </a>
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        bloque.items.map((t, i) => (
          <li data-reveal style={`--d:${(i % 3) * 100}ms`}>
            <figure class="flex h-full flex-col gap-6 rounded-(--radius-card) p-6 ring-1 ring-crema/15 lg:p-8">
              <Icon name="quotes" class="size-8 text-teja" />
              <blockquote class="flex-1 font-display text-xl leading-snug lg:text-2xl">
                <p>{t.texto}</p>
              </blockquote>
              <figcaption class="text-sm text-crema/70">{t.autor}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
