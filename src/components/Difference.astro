---
import Icon from './Icon.astro';
import { imageUrl } from '../data/assets';
import type { BloqueDiferencia, SiteContent } from '../data/sitio';

interface Props {
  bloque: BloqueDiferencia;
  site: SiteContent;
}

const { bloque, site } = Astro.props;
const { marca } = site;
---

<!-- La diferencia: comparación con la competencia y el proceso, del campo a la mesa. -->
<section id="diferencia" aria-labelledby="diferencia-title" class="px-4 py-24 md:px-12 xl:px-24">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <p data-reveal class="text-sm text-teja">{bloque.eyebrow}</p>
      <h2 id="diferencia-title" data-reveal style="--d:100ms" class="mt-4 text-3xl lg:text-5xl">{bloque.titulo}</h2>
      {bloque.texto && <p data-reveal style="--d:200ms" class="mt-6 text-base text-crema/70 lg:text-lg">{bloque.texto}</p>}
    </div>

    {bloque.filas.length > 0 && (
    <div data-reveal class="mt-12 overflow-hidden rounded-(--radius-card) ring-1 ring-crema/15">
      <table class="w-full text-left text-sm lg:text-base">
        <caption class="sr-only">Comparación entre {marca.nombre} y {bloque.nombreOtro}</caption>
        <thead class="bg-crema/[0.06] text-xs tracking-widest uppercase">
          <tr>
            <th scope="col" class="w-1/2 px-4 py-4 font-medium text-teja lg:px-8">{marca.nombre}</th>
            <th scope="col" class="w-1/2 px-4 py-4 font-medium text-crema/50 lg:px-8">{bloque.nombreOtro}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-crema/10">
          {
            bloque.filas.map((fila) => (
              <tr>
                <td class="px-4 py-4 align-top lg:px-8">
                  <span class="flex items-start gap-2">
                    <Icon name="check" class="mt-0.5 size-4 shrink-0 text-teja lg:size-5" />
                    {fila.nuestro}
                  </span>
                </td>
                <td class="px-4 py-4 align-top text-crema/50 lg:px-8">
                  <span class="flex items-start gap-2">
                    <Icon name="x" class="mt-0.5 size-4 shrink-0 lg:size-5" />
                    <span class="line-through decoration-crema/30">{fila.otro}</span>
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    )}

    <div class="mt-24 grid items-center gap-12 md:grid-cols-2">
      <div data-reveal class="mirror-frame mask-arch mx-auto w-full max-w-sm">
        <!-- Vídeo en bucle y sin sonido. Se descarga y reproduce solo cuando está cerca de la pantalla; mientras tanto
             (o con movimiento reducido) se ve la imagen. Sin vídeo, solo la imagen. -->
        {
          bloque.video ? (
            <video
              data-autoplay
              data-src={bloque.video}
              poster={imageUrl(bloque.poster.src)}
              muted
              loop
              playsinline
              preload="none"
              disablepictureinpicture
              role="img"
              aria-label={bloque.poster.alt}
              class="block aspect-[4/5] w-full mask-arch object-cover"
            />
          ) : (
            bloque.poster.src && (
              <img
                src={imageUrl(bloque.poster.src)}
                alt={bloque.poster.alt}
                loading="lazy"
                decoding="async"
                class="block aspect-[4/5] w-full mask-arch object-cover"
              />
            )
          )
        }
      </div>
      <div>
        <p data-reveal class="text-sm text-teja">{bloque.eyebrow2}</p>
        <h2 data-reveal style="--d:100ms" class="mt-4 text-3xl lg:text-5xl">{bloque.titulo2}</h2>
        <ol class="mt-8 flex flex-col gap-6">
          {
            bloque.pasos.map((paso, i) => (
              <li data-reveal style={`--d:${150 + i * 80}ms`} class="flex gap-6">
                <span class="font-display text-2xl text-teja tabular-nums">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="text-xl lg:text-2xl">{paso.titulo}</h3>
                  <p class="mt-1 text-base text-crema/70">{paso.texto}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/autoplay-video';
</script>

