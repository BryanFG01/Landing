---
// Cuerpo de la landing: los bloques visibles en el orden del panel (Sitio web). Lo usan la portada y la vista previa.
import ScrollWorld from './ScrollWorld.astro';
import Tagline from './Tagline.astro';
import Dishes from './Dishes.astro';
import Difference from './Difference.astro';
import Testimonials from './Testimonials.astro';
import Faq from './Faq.astro';
import Gift from './Gift.astro';
import FinalCta from './FinalCta.astro';
import type { SiteContent, TipoBloque } from '../data/sitio';

interface Props {
  site: SiteContent;
}

const { site } = Astro.props;

const COMPONENTS: Record<TipoBloque, typeof ScrollWorld> = {
  paseo: ScrollWorld,
  frase: Tagline,
  productos: Dishes,
  diferencia: Difference,
  opiniones: Testimonials,
  preguntas: Faq,
  semanal: Gift,
  final: FinalCta,
};
---

{
  site.bloques
    .filter((b) => b.visible)
    .map((b) => {
      const Block = COMPONENTS[b.tipo];
      return <Block bloque={b as never} site={site} />;
    })
}
