---
import { marca } from '../data/finca';

// Logo provisional en texto hasta tener el de la finca. El tamaño se da con clases de texto (text-lg, text-2xl…).
interface Props {
  class?: string;
}

const { class: className = 'text-xl' } = Astro.props;
---

<span class:list={['font-display leading-none whitespace-nowrap', className]}>{marca.nombre}</span>
