---
import Icon from './Icon.astro';
import Media from './Media.astro';
import { rich, waLink, type BloqueSemanal, type SiteContent } from '../data/sitio';

interface Props {
  bloque: BloqueSemanal;
  site: SiteContent;
}

const { bloque, site } = Astro.props;
---

<section id="semanal" aria-labelledby="semanal-title" class="px-4 py-24 md:px-12 xl:px-24">
  <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2">
    {
      bloque.imagen.src && (
        <div data-reveal class="mirror-frame mask-mirror mx-auto w-full max-w-sm">
          <Media
            img={bloque.imagen}
            widths={[400, 640, 800]}
            sizes="(min-width: 768px) 384px, 90vw"
            pictureClass="block"
            class="aspect-[4/5] w-full mask-mirror object-cover"
          />
        </div>
      )
    }
    <div>
      <p data-reveal class="text-sm text-teja">{bloque.eyebrow}</p>
      <h2 id="semanal-title" data-reveal style="--d:100ms" class="mt-4 text-3xl lg:text-5xl">{bloque.titulo}</h2>
      <p data-reveal style="--d:200ms" class="mt-6 max-w-md text-base text-crema/70 lg:text-lg" set:html={rich(bloque.texto)} />
      {
        bloque.boton && (
          <div data-reveal style="--d:300ms" class="mt-8">
            <a href={waLink(site, bloque.mensaje)} class="btn btn-ghost" rel="noopener" target="_blank">
              <Icon name="whatsapp" class="size-5" />
              <span>{bloque.boton}</span>
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>
