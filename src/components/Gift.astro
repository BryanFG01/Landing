---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Pending from './Pending.astro';
import { links, photos } from '../data/finca';
---

<section id="semanal" aria-labelledby="semanal-title" class="px-4 py-24 md:px-12 xl:px-24">
  <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2">
    <div data-reveal class="mirror-frame mask-mirror mx-auto w-full max-w-sm">
      <Picture
        src={photos.seleccion}
        alt="Una mano acomoda huevos colorados en su cubeta"
        formats={['avif', 'webp']}
        widths={[400, 640, 800]}
        sizes="(min-width: 768px) 384px, 90vw"
        loading="lazy"
        decoding="async"
        pictureAttributes={{ class: 'block' }}
        class="aspect-[4/5] w-full mask-mirror object-cover"
      />
    </div>
    <div>
      <p data-reveal class="text-sm text-teja">Pedido fijo</p>
      <h2 id="semanal-title" data-reveal style="--d:100ms" class="mt-4 text-3xl lg:text-5xl">Huevos frescos cada semana, sin acordarte</h2>
      <p data-reveal style="--d:200ms" class="mt-6 max-w-md text-base text-crema/70 lg:text-lg">
        Dinos qué necesitas y cada cuánto. Te lo llevamos el mismo día de cada semana y lo cambias o pausas cuando quieras
        por WhatsApp.
      </p>
      <div data-reveal style="--d:300ms" class="mt-8">
        <a href={links.semanal} class="btn btn-ghost" rel="noopener" target="_blank">
          <Icon name="whatsapp" class="size-5" />
          <span>Quiero mi pedido semanal</span>
        </a>
      </div>
      <Pending class="mt-6 max-w-md">Confirmar si se ofrece pedido fijo semanal y en qué condiciones.</Pending>
    </div>
  </div>
</section>
