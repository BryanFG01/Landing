---
// Imagen del contenido editable: si es del proyecto ("asset:…"), Picture con AVIF/WebP y tamaños; si se subió desde el
// panel ("/media/…", ya reducida en el navegador), un <img> normal.
import { Picture } from 'astro:assets';
import { assetFor } from '../data/assets';
import type { Img } from '../data/sitio';

interface Props {
  img: Img;
  widths: number[];
  sizes: string;
  class?: string;
  pictureClass?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  alt?: string;
  style?: string;
}

const { img, widths, sizes, class: className, pictureClass, loading = 'lazy', fetchpriority, alt, style } = Astro.props;
const asset = assetFor(img.src);
const text = alt ?? img.alt;
---

{
  asset ? (
    <Picture
      src={asset}
      alt={text}
      formats={['avif', 'webp']}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      pictureAttributes={{ class: pictureClass }}
      class={className}
      style={style}
    />
  ) : (
    img.src && (
      <picture class={pictureClass}>
        <img src={img.src} alt={text} loading={loading} decoding="async" class={className} style={style} {...(fetchpriority ? { fetchpriority } : {})} />
      </picture>
    )
  )
}
