---
import { Image } from 'astro:assets';
import Pending from './Pending.astro';
import Spiral from './Spiral.astro';
import logo from '../assets/marca/logo.png';
import { contacto, links, marca } from '../data/finca';
---

<section id="pedir" aria-labelledby="final-title" class="relative overflow-hidden px-4 py-24 md:px-12 xl:px-24">
  <Spiral rings={12} class="pointer-events-none absolute right-0 bottom-0 w-[640px] translate-x-1/3 translate-y-1/3 text-crema/10" />
  <div class="relative mx-auto flex max-w-[680px] flex-col items-center text-center">
    <div data-reveal class="w-48 lg:w-56">
      <Image
        src={logo}
        alt={`Logo de ${marca.nombre}, distribuidora de huevos y pollos`}
        widths={[224, 448]}
        sizes="(min-width: 1024px) 224px, 192px"
        format="webp"
        loading="lazy"
        decoding="async"
        class="aspect-square w-full rounded-full bg-white object-cover shadow-2xl shadow-black/40 ring-1 ring-crema/20"
      />
    </div>
    <h2 id="final-title" data-reveal style="--d:100ms" class="mt-12 text-4xl lg:text-6xl">
      Pide hoy,<br /> cocínalo hoy
    </h2>
    <p data-reveal style="--d:200ms" class="mt-6 text-base text-crema/70 lg:text-lg">
      Un mensaje por WhatsApp y en unas horas está en tu cocina. Si confirmas antes de las 10:00&nbsp;a.&nbsp;m., lo recibes el
      mismo día en {contacto.zonaEntrega}.
    </p>
    <dl data-reveal style="--d:250ms" class="mt-8 grid w-full gap-4 text-left text-sm sm:grid-cols-2">
      <div class="rounded-2xl p-4 ring-1 ring-crema/15">
        <dt class="text-xs tracking-widest text-teja uppercase">Horario de pedidos</dt>
        <dd class="mt-1">{contacto.horario}</dd>
      </div>
      <div class="rounded-2xl p-4 ring-1 ring-crema/15">
        <dt class="text-xs tracking-widest text-teja uppercase">Medios de pago</dt>
        <dd class="mt-1">{contacto.pagos}</dd>
      </div>
    </dl>
    <div data-reveal style="--d:300ms" class="mt-8 flex flex-col items-center gap-4">
      <a href={links.pedir} class="btn btn-primary" rel="noopener" target="_blank"><span>Pedir por WhatsApp</span></a>
      <p class="text-sm text-crema/70">
        O llámanos al <a href={links.telefono} class="link whitespace-nowrap">{contacto.telefono}</a>
      </p>
    </div>
    <Pending class="mt-8">Ciudad desde donde se despacha y si el domicilio tiene costo.</Pending>
  </div>
</section>
