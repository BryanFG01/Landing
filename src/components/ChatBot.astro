---
// Chat de ayuda flotante. Se configura en el panel (Sitio web → Chat de ayuda); la conversación la lleva
// src/scripts/chat.ts y las reglas del pedido src/data/chat.ts.
import { imageUrl } from '../data/assets';
import { buildChatData } from '../data/chat';
import type { SiteContent } from '../data/sitio';

interface Props {
  site: SiteContent;
}

const { site } = Astro.props;
const data = buildChatData(site, imageUrl(site.marca.logo.src));
const json = JSON.stringify(data).replaceAll('<', '\\u003c');
const side = site.chat.posicion === 'izquierda' ? 'left' : 'right';
---

<div data-chat data-side={side} class="chat">
  <button type="button" data-chat-open class="chat-launcher" aria-expanded="false" aria-controls="chat-panel">
    <svg aria-hidden="true" viewBox="0 0 256 256" class="size-5 shrink-0" fill="currentColor">
      <path
        d="M128 24a104 104 0 0 0-91.82 152.88l-11.35 34.05a16 16 0 0 0 20.24 20.24l34.05-11.35A104 104 0 1 0 128 24m0 192a87.87 87.87 0 0 1-44.06-11.81 8 8 0 0 0-4-1.08 8.3 8.3 0 0 0-2.53.41L40 216l12.47-37.4a8 8 0 0 0-.66-6.54A88 88 0 1 1 128 216"
      ></path>
    </svg>
    <span class="chat-launcher-text">{site.chat.boton}</span>
  </button>

  <section id="chat-panel" data-chat-panel class="chat-panel" role="dialog" aria-labelledby="chat-title" hidden>
    <header class="chat-header">
      {data.logo && <img src={data.logo} alt="" width="36" height="36" class="size-9 shrink-0 rounded-full bg-white object-cover" />}
      <div class="min-w-0 flex-1">
        <h2 id="chat-title" class="truncate font-sans text-sm font-medium">{data.nombre}</h2>
        <p class="truncate text-xs text-crema/60">{data.marca} · Responde al instante</p>
      </div>
      <button type="button" data-chat-close class="chat-close" aria-label="Cerrar el chat">
        <svg aria-hidden="true" viewBox="0 0 256 256" class="size-5" fill="currentColor">
          <path
            d="M205.66 194.34a8 8 0 0 1-11.32 11.32L128 139.31l-66.34 66.35a8 8 0 0 1-11.32-11.32L116.69 128 50.34 61.66a8 8 0 0 1 11.32-11.32L128 116.69l66.34-66.35a8 8 0 0 1 11.32 11.32L139.31 128Z"
          ></path>
        </svg>
      </button>
    </header>
    <div data-chat-log data-lenis-prevent class="chat-log" role="log" aria-live="polite"></div>
    <div data-chat-actions data-lenis-prevent class="chat-actions"></div>
  </section>

  <script type="application/json" data-chat-data set:html={json} is:inline></script>
</div>

<script>
  import '../scripts/chat';
</script>

<style is:global>
  .chat {
    --chat-ease: var(--ease-fluid);
    position: fixed;
    bottom: 1rem;
    z-index: 65;
    display: flex;
    /* El botón queda abajo y el panel se abre encima de él. */
    flex-direction: column-reverse;
    align-items: flex-end;
    gap: 0.75rem;
    /* El contenedor no recibe clics (en móvil ocupa el ancho): solo el botón y el panel. */
    pointer-events: none;
  }
  .chat > * {
    pointer-events: auto;
  }
  .chat[data-side='right'] {
    right: 1rem;
  }
  .chat[data-side='left'] {
    left: 1rem;
    align-items: flex-start;
  }
  /* Con el menú móvil abierto, el chat no estorba. */
  body:has(#menu[data-open]) .chat {
    display: none;
  }

  .chat-launcher {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9999px;
    background: var(--btn-bg);
    color: var(--color-on-teja);
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.35);
    transition:
      transform 700ms var(--chat-ease),
      opacity 700ms var(--chat-ease);
  }
  .chat-launcher:hover {
    transform: translateY(-2px);
  }
  .chat-launcher:active {
    transform: scale(0.98);
  }
  .chat-launcher:focus-visible,
  .chat-close:focus-visible,
  .chat-choice:focus-visible,
  .chat-step:focus-visible,
  .chat-send:focus-visible {
    outline: 2px solid var(--color-teja);
    outline-offset: 2px;
  }
  .chat[data-open] .chat-launcher-text {
    display: none;
  }

  .chat-panel {
    display: flex;
    flex-direction: column;
    width: min(380px, calc(100vw - 2rem));
    height: min(560px, calc(100svh - 6rem));
    overflow: hidden;
    border-radius: 1.5rem;
    background: var(--color-bg);
    color: var(--color-crema);
    box-shadow:
      0 24px 64px rgb(0 0 0 / 0.45),
      0 0 0 1px color-mix(in oklab, var(--color-crema) 15%, transparent);
    transform-origin: bottom right;
    animation: chat-in 500ms var(--chat-ease);
  }
  .chat[data-side='left'] .chat-panel {
    transform-origin: bottom left;
  }
  .chat-panel[hidden] {
    display: none;
  }
  @keyframes chat-in {
    from {
      opacity: 0;
      transform: translateY(1rem) scale(0.96);
    }
  }

  .chat-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-crema) 10%, transparent);
  }
  .chat-close {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    color: color-mix(in oklab, var(--color-crema) 70%, transparent);
  }
  .chat-close:hover {
    background: color-mix(in oklab, var(--color-crema) 10%, transparent);
    color: var(--color-crema);
  }

  .chat-log {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1rem;
  }
  .chat-msg {
    max-width: 85%;
    white-space: pre-line;
    border-radius: 1rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    animation: chat-msg-in 400ms var(--chat-ease);
  }
  .chat-msg-bot {
    align-self: flex-start;
    border-bottom-left-radius: 0.25rem;
    background: color-mix(in oklab, var(--color-crema) 10%, transparent);
  }
  .chat-msg-user {
    align-self: flex-end;
    border-bottom-right-radius: 0.25rem;
    background: var(--color-teja);
    color: var(--color-on-teja);
  }
  .chat-msg strong {
    font-weight: 600;
  }
  @keyframes chat-msg-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }
  .chat-typing {
    display: flex;
    gap: 0.25rem;
    padding: 0.75rem;
  }
  .chat-typing span {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    background: currentColor;
    opacity: 0.4;
    animation: chat-dot 1s infinite;
  }
  .chat-typing span:nth-child(2) {
    animation-delay: 150ms;
  }
  .chat-typing span:nth-child(3) {
    animation-delay: 300ms;
  }
  @keyframes chat-dot {
    50% {
      opacity: 1;
    }
  }

  .chat-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 50%;
    overflow-y: auto;
    padding: 0.75rem 1rem 1rem;
    border-top: 1px solid color-mix(in oklab, var(--color-crema) 10%, transparent);
  }
  .chat-actions:empty {
    display: none;
  }
  .chat-choice {
    border-radius: 9999px;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    text-align: left;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-crema) 25%, transparent);
    transition: background-color 400ms var(--chat-ease);
  }
  .chat-choice:hover {
    background: color-mix(in oklab, var(--color-crema) 10%, transparent);
  }
  .chat-choice:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .chat-choice-primary {
    background: var(--color-teja);
    color: var(--color-on-teja);
    font-weight: 600;
    box-shadow: none;
  }
  .chat-choice-primary:hover {
    background: color-mix(in oklab, var(--color-teja) 85%, white);
  }

  .chat-picker {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .chat-product {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 1rem;
    padding: 0.5rem 0.75rem;
    background: color-mix(in oklab, var(--color-crema) 6%, transparent);
  }
  .chat-product-name {
    font-size: 0.875rem;
  }
  .chat-product-price {
    font-size: 0.75rem;
    color: color-mix(in oklab, var(--color-crema) 65%, transparent);
  }
  .chat-step {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    font-size: 1rem;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-crema) 25%, transparent);
  }
  .chat-step:hover {
    background: color-mix(in oklab, var(--color-crema) 10%, transparent);
  }
  .chat-qty {
    min-width: 1.5rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .chat-form {
    display: flex;
    gap: 0.5rem;
  }
  .chat-input {
    flex: 1;
    min-width: 0;
    border-radius: 9999px;
    background: color-mix(in oklab, var(--color-crema) 8%, transparent);
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
    color: var(--color-crema);
    outline: none;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-crema) 20%, transparent);
  }
  .chat-input:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-teja);
  }
  .chat-hint {
    font-size: 0.75rem;
    color: color-mix(in oklab, var(--color-teja) 80%, white);
  }
  .chat-hint:empty {
    display: none;
  }
  .chat-send {
    border-radius: 9999px;
    background: var(--color-teja);
    color: var(--color-on-teja);
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* Móvil: el panel ocupa el ancho de la pantalla, como una hoja inferior. */
  @media (max-width: 480px) {
    .chat {
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.75rem;
    }
    .chat[data-side='left'],
    .chat[data-side='right'] {
      left: auto;
      right: auto;
      inset-inline: 0.75rem;
    }
    .chat-panel {
      width: 100%;
      height: min(600px, calc(100svh - 5.5rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-panel,
    .chat-msg {
      animation: none;
    }
    .chat-typing span {
      animation: none;
    }
  }
</style>
