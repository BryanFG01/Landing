---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '@/features/landing/components/Header.astro';
import Footer from '@/features/landing/components/Footer.astro';
import ChatBot from '@/features/landing/components/ChatBot.astro';
import { siteFor } from '@/features/landing/server/contenido';
import { layoutView } from './Layout.view';
import type { Props } from './Layout.types';

const site = await siteFor(Astro);
const { marca, tema, title, description, noindex, header, fonts, canonical, ogUrl, ogAlt, robots, temaCss, hasChat } =
  layoutView(site, Astro.props, Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={tema.fondo} />

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="es-CO" href={canonical} />
          <link rel="alternate" hreflang="x-default" href={canonical} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={marca.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:secure_url" content={ogUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {fonts.map((css) => <Font cssVariable={css as '--font-hina'} preload />)}
    <!-- Colores y tipografías del panel (Sitio web → Colores y tipografía). -->
    <style is:inline set:html={temaCss}></style>

    <slot name="head" />
  </head>
  <body class="min-h-svh overflow-x-clip">
    {header && <Header site={site} />}
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer site={site} />
    {hasChat && <ChatBot site={site} />}
    <script>
      import '@/features/landing/scripts/motion';
      import '@/features/landing/scripts/metrics';
    </script>
  </body>
</html>
