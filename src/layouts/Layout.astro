---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatBot from '../components/ChatBot.astro';
import { ogImage } from '../data/imagenes';
import { siteFor } from '../data/contenido';
import { FONTS, plain, temaCss } from '../data/sitio';

interface Props {
  /** Sin título ni descripción, los del SEO del panel (Sitio web). */
  title?: string;
  description?: string;
  noindex?: boolean;
  header?: boolean;
}

const site = await siteFor(Astro);
const { marca, tema } = site;
const {
  title = site.seo.titulo,
  description = plain(site.seo.descripcion),
  noindex = false,
  header = true,
} = Astro.props;
// Solo se cargan las dos tipografías elegidas en el panel.
const fonts = [...new Set([FONTS[tema.titulos].css, FONTS[tema.cuerpo].css])];
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage.src, Astro.site);
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={tema.fondo} />

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="es-CO" href={canonical} />
          <link rel="alternate" hreflang="x-default" href={canonical} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={marca.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:secure_url" content={ogUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogImage.alt} />

    {fonts.map((css) => <Font cssVariable={css as '--font-hina'} preload />)}
    <!-- Colores y tipografías del panel (Sitio web → Colores y tipografía). -->
    <style is:inline set:html={temaCss(tema)}></style>

    <slot name="head" />
  </head>
  <body class="min-h-svh overflow-x-clip">
    {header && <Header site={site} />}
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer site={site} />
    {site.chat.activo === 'si' && <ChatBot site={site} />}
    <script>
      import '../scripts/motion';
      import '../scripts/metrics';
    </script>
  </body>
</html>
