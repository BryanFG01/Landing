---
import Layout from '../layouts/Layout.astro';
import Landing from '../components/Landing.astro';
import { getSite } from '../data/contenido';
import { structuredData } from '../data/schema';

// Se prerenderiza con el contenido publicado desde el panel (Sitio web → Publicar lanza un nuevo despliegue).
const site = Astro.site;
if (!site) throw new Error('Falta site en astro.config.mjs');
const content = await getSite();
const jsonLd = JSON.stringify(structuredData(site, content)).replaceAll('<', '\\u003c');
---

<Layout>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />
  <Landing site={content} />
</Layout>
