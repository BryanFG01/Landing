---
// Política de tratamiento de datos (Ley 1581 de 2012). El texto se edita en el panel (Sitio web → Privacidad); aquí solo
// se pinta. Sin la cabecera de la landing: sus enlaces llevan a secciones de la portada.
import Layout from '../layouts/Layout.astro';
import Logo from '@/features/landing/components/Logo.astro';
import Icon from '@/features/landing/components/Icon.astro';
import LegalBlock from '@/features/landing/components/legal/LegalBlock.astro';
import { getSite } from '@/features/landing/server/contenido';
import { legalBlocks } from '@/features/landing/domain/sitio';

const site = await getSite();
const { marca, legal } = site;
const blocks = legalBlocks(site);
---

<Layout
  title={`Política de privacidad · ${marca.nombre}`}
  description={`Cómo trata ${marca.nombre} los datos personales de quienes hacen pedidos: qué datos, para qué y cómo ejercer tus derechos.`}
  header={false}
>
  <article class="mx-auto max-w-2xl px-4 pt-12 pb-24 md:pt-16">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <a href="/" aria-label={`${marca.nombre}, volver al inicio`}><Logo site={site} class="text-lg" /></a>
      <a href="/" class="btn btn-ghost btn-sm"><Icon name="arrowLeft" class="size-4" /><span>Volver al inicio</span></a>
    </div>

    <h1 class="mt-16 text-4xl lg:text-5xl">Política de tratamiento de datos</h1>
    <p class="mt-4 text-sm text-crema/60">Última actualización: {legal.actualizado}</p>

    <div class="mt-12 flex flex-col gap-6">
      {blocks.map((b) => <LegalBlock bloque={b} />)}
    </div>
  </article>
</Layout>
