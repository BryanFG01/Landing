---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { LoginView } from '../../admin/ui/LoginView';
import { getAppearance } from '../../admin/server/settings';
import { isLightTheme, loginThemeCss } from '../../admin/schema';
import foto from '../../assets/paseo/bascula.webp';
import { getSite } from '../../data/contenido';
import { SITE_DEFAULTS, type SiteContent } from '../../data/sitio';

export const prerender = false;

// Con sesión iniciada no tiene sentido ver el login.
if (Astro.locals.adminUser) return Astro.redirect('/admin');

const appearance = await getAppearance();
// El login se viste con la plantilla publicada en la web (colores y tipografías). Si no se puede leer, la de siempre.
let site: SiteContent = SITE_DEFAULTS;
try {
  site = await getSite();
} catch (e) {
  console.warn('[login] Sin el contenido publicado:', e instanceof Error ? e.message : e);
}
const { tema, marca } = site;
---

<AdminLayout
  title="Entrar"
  theme={isLightTheme(tema) ? 'light' : 'dark'}
  appearance={appearance}
  extraCss={loginThemeCss(tema)}
  fonts={{ titulos: tema.titulos, cuerpo: tema.cuerpo, peso: tema.pesoTitulos }}
>
  <LoginView
    client:only="react"
    image={foto.src}
    brand={appearance.name}
    tagline={marca.lema}
    logo={appearance.logo || '/icon-192.png'}
    title={appearance.login_title}
    text={appearance.login_text}
  />
</AdminLayout>
