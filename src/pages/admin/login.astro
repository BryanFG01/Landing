---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { LoginView } from '../../admin/ui/LoginView';
import foto from '../../assets/paseo/paseo-3.webp';
import { marca } from '../../data/finca';

export const prerender = false;

// Con sesión iniciada no tiene sentido ver el login.
if (Astro.locals.adminUser) return Astro.redirect('/admin');
---

<AdminLayout title="Entrar" theme="dark">
  <LoginView client:only="react" image={foto.src} brand={marca.nombre} tagline={marca.lema} />
</AdminLayout>
