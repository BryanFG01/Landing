---
// Todo /admin (salvo /admin/login) es una sola página: el panel React se monta una vez y navega en cliente,
// así cambiar de módulo no recarga la página. Aquí solo se pasan el usuario, el menú, la apariencia y la plantilla
// publicada de la web (de la que el panel toma sus colores) para el primer pintado; cada vista pide sus datos a
// /api/admin. El middleware ya ha comprobado la sesión.
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminApp from '@/features/admin/shell/ui/AdminApp';
import { getNav } from '@/features/admin/core/server/modules';
import { getAppearance } from '@/features/admin/appearance/server/settings';
import { getPublishedPanelTheme } from '@/features/admin/site-editor/server/panelTheme';

export const prerender = false;

const user = Astro.locals.adminUser!;
// Sin la plantilla (base caída a medias), el panel usa los colores de Apariencia.
const [nav, appearance, site] = await Promise.all([getNav(user), getAppearance(), getPublishedPanelTheme()]);
---

<AdminLayout title="Panel" appearance={appearance} site={site}>
  <AdminApp client:only="react" user={user} nav={nav} appearance={appearance} siteTheme={site} />
</AdminLayout>
